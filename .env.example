# Copy to .env in the TripTalk project root; never commit real credentials.
# Next.js server and Node CLI only; never expose secrets to the browser.
# Never prefix secrets with NEXT_PUBLIC_ or inject them through next.config env.
OPENAI_API_KEY=
# Low-cost P0 starting point; account access must still be verified.
OPENAI_MODEL=gpt-6-luna
# Recorded speech -> editable draft; independent from the teaching model.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Real API mode requires a valid key/model. Never silently fall back to mock.
# P0/P1 implement openai only. Mock is optional later, never Agent acceptance.
AI_MODE=openai
DATA_DIR=./data
# Start the single Next.js app on 127.0.0.1:3000 via package scripts.
